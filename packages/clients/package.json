{
  "name": "@acme/clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./pyapp": {
      "default": "./src/pyapp/index.ts"
    },
    "./pyapp/react-query": {
      "default": "./src/pyapp/@tanstack/react-query.gen.ts"
    }
  },
  "scripts": {
    "codegen": "openapi-ts -i ../../apps/pyapp/openapi.json -o ./src/pyapp -c @hey-api/client-fetch -p @tanstack/react-query",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.9.0",
    "@tanstack/react-query": "^5.62.0"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@hey-api/openapi-ts": "^0.66.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "prettier": "@acme/config/prettier"
}

