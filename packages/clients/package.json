{
  "name": "@acme/clients",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pyapp": "./src/pyapp/index.ts",
    "./pyapp/react-query": "./src/pyapp/@tanstack/react-query.gen.ts"
  },
  "scripts": {
    "codegen": "pnpm codegen:pyapp",
    "codegen:pyapp": "pnpm dlx --package=@hey-api/openapi-ts@0.99.0 --package=typescript@6.0.3 openapi-ts -i ../../apps/pyapp/openapi.json -o ./src/pyapp -p @hey-api/client-fetch @tanstack/react-query",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "typescript": "7.0.2"
  }
}
