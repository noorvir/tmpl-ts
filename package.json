{
  "name": "tmpl-ts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "build": "pnpm -r --if-present build",
    "clean": "git clean -xdf node_modules",
    "db:push": "pnpm --filter @acme/db db:push",
    "db:studio": "pnpm --filter @acme/db db:studio",
    "clients:codegen": "pnpm --filter @acme/clients codegen",
    "clients:add": "node scripts/add-client.ts",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "oxlint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "26.6.6",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2"
  },
  "prettier": "@acme/config/prettier"
}
