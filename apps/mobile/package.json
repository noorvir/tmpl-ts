  "devDependencies": {
    "@acme/api": "workspace:*",
    "@acme/config": "workspace:*",
    "@types/react": "~19.1.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tailwindcss": "3",
    "typescript": "~5.9.2"
