{
  "name": "@acme/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --go",
    "dev:ios": "expo start --go --ios",
    "dev:android": "expo start --go --android",
    "dev:client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-navigation/native": "7.5.1",
    "@tanstack/react-query": "5.105.1",
    "expo": "58.0.22",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.14",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.15",
    "expo-location": "58.0.20",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-web-browser": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "twrnc": "4.16.0",
    "@acme/api": "workspace:*"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@types/react": "19.3.0",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "@babel/plugin-transform-parameters": "8.0.5",
    "babel-preset-expo": "58.0.23"
  }
}
