{
  "name": "@acme/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Electron desktop app integrated with monorepo UI and tRPC",
  "main": "./out/main/index.js",
  "author": "acme",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "build": "bun run typecheck && electron-vite build",
    "clean": "git clean -xdf .cache .turbo dist node_modules out",
    "dev": "electron-vite dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "electron-vite preview",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@acme/api": "workspace:*",
    "@acme/ui": "workspace:*",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-query": "^5.80.2",
    "@trpc/client": "^11.2.0",
    "@trpc/tanstack-react-query": "^11.2.0",
    "electron-store": "^9.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "superjson": "2.2.2"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv-cli": "^8.0.0",
    "electron": "^37.2.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  },
  "prettier": "@acme/config/prettier"
}
