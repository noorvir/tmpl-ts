{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": false,
    "composite": false,
    "isolatedModules": false,
    "declaration": false
  },
  "include": ["src/main.ts", "src/preload.ts", "src/types.d.ts"]
}